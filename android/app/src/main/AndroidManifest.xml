<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!--
            AppBlockerService — Accessibility Service that watches foreground app
            changes and launches BlockedOverlayActivity when a blocked app opens.
            The user must enable this manually in Settings > Accessibility.
        -->
        <service
            android:name=".AppBlockerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
            BlockedOverlayActivity — fullscreen "app paused" screen shown over
            the blocked app. singleTop prevents multiple stacked instances.
        -->
        <activity
            android:name=".BlockedOverlayActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:excludeFromRecents="true" />

    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        PACKAGE_USAGE_STATS is a "special" (protected) permission.
        It cannot be granted at runtime — the user must enable it manually in
        System Settings > Apps > Special app access > Usage access.
        tools:ignore suppresses the lint warning about protected permissions.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        SYSTEM_ALERT_WINDOW allows BlockedOverlayActivity to appear on top of
        other apps. Required for the blocking overlay to show when a blocked app
        is opened. The user must grant this in Special app access > Display over
        other apps (Android 6+).
    -->
    <uses-permission
        android:name="android.permission.SYSTEM_ALERT_WINDOW" />
</manifest>
